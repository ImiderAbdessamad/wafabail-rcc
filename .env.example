# Serveur Ollama cloud
# https://ollama-lnhh4y-11434.svc-usw2.nicegpu.com/
OLLAMA_URL=https://ollama-lnhh4y-11434.svc-usw2.nicegpu.com
OLLAMA_MODEL=hf.co/unsloth/GLM-4.6V-Flash-GGUF:Q4_K_M
OLLAMA_VISION_MODEL=hf.co/unsloth/GLM-4.6V-Flash-GGUF:Q4_K_M
OLLAMA_TIMEOUT=600
ALLOWED_ORIGINS=*
MAX_UPLOAD_MB=50

DIRECT_FINANCIAL_MODEL=hf.co/unsloth/GLM-4.6V-Flash-GGUF:Q4_K_M
DIRECT_FINANCIAL_TIMEOUT_SECONDS=600
DIRECT_FINANCIAL_NUM_CTX=8192
DIRECT_FINANCIAL_NUM_PREDICT=4096
DIRECT_FINANCIAL_KEEP_ALIVE=20m
DIRECT_FINANCIAL_MAX_ATTEMPTS=2
DIRECT_FINANCIAL_RENDER_DPI=180
DIRECT_FINANCIAL_MAX_PAGES=60
DIRECT_FINANCIAL_PAGE_DELAY_SECONDS=0.5
DIRECT_FINANCIAL_MAX_IMAGE_DIMENSION=1600
DIRECT_FINANCIAL_REGION_FALLBACK=true
DIRECT_FINANCIAL_JOB_TTL_MINUTES=60

# --- Moteur d'extraction RCC (noms exacts de GET /api/tags) ---
RCC_OLLAMA_URL=https://ollama-lnhh4y-11434.svc-usw2.nicegpu.com
RCC_VISION_MODEL=hf.co/unsloth/GLM-4.6V-Flash-GGUF:Q4_K_M
RCC_OCR_MODEL=glm-ocr:q8_0
RCC_VERIFY_MODEL=qwen3-vl:30b
RCC_MAPPER_MODEL=qwen3.5:9b
RCC_ADJUDICATOR_MODEL=gemma4:latest
RCC_USE_GLM_VERIFICATION=true
RCC_USE_REASONING_MAPPER=true
RCC_USE_ADJUDICATOR=true
RCC_REQUEST_TIMEOUT_SECONDS=600
RCC_KEEP_ALIVE=20m
RCC_RENDER_DPI=220
RCC_EXTRACT_MAX_SIDE=2400

# --- Persistance (dossiers, corrections, sessions) ---
DATA_DIR=data
# DB_PATH=data/wafabail_rcc.sqlite3
# PDF_STORAGE_DIR=data/pdfs

# --- Authentification analyste (rôle unique « valideur RCC ») ---
ANALYST_USERNAME=analyste@wafabail.ma
ANALYST_PASSWORD=wafabail2026
ANALYST_DISPLAY_NAME=Analyste RCC
SESSION_TTL_HOURS=12
# Mettre à true derrière HTTPS
SESSION_COOKIE_SECURE=false

# Seuil sous lequel un poste est signalé « à vérifier » (serveur + interface)
CONFIDENCE_REVIEW_THRESHOLD=0.8
